<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agv_vision</name>
  <version>0.1.0</version>
  <description>카메라 영상 처리 — 라인 검출 (색 마커·AI 분류는 다음 단계)</description>
  <maintainer email="noreply@example.com">logistics-automation team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>agv_interfaces</exec_depend>
  <exec_depend>agv_protocol</exec_depend>
  <exec_depend>agv_bt</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
